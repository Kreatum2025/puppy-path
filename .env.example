# Supabase (public values — safe to expose in the app, see docs/SUPABASE_PLAN.md).
# Copy this file to `.env` and fill in your project's values.
# Leave unset to run the app on local mock breed data (fallback path).
#
# Never put secret keys here or in the app: service-role key, OpenAI key,
# TheDogAPI secret and Stripe secret belong in Supabase Edge Function secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
